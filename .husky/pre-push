#!/bin/sh

# Skip checks when deleting a remote branch (local sha is all zeroes)
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    exit 0
  fi
done

echo "🔍 Running pre-push checks on affected projects..."

BASE_REF="origin/main"
if ! git rev-parse --verify "$BASE_REF" >/dev/null 2>&1; then
  BASE_REF="HEAD~1"
fi

pnpm nx affected -t test build --base="$BASE_REF"

# Verify API contract drift if backend code was modified
if git diff --name-only "$BASE_REF" HEAD 2>/dev/null | grep -q "^apps/server/"; then
  echo "📡 Backend modifications detected. Verifying client API schema synchronization..."
  pnpm codegen:api
  if ! git diff --exit-code apps/client/src/api/generated/api-schema.ts >/dev/null 2>&1; then
    echo ""
    echo "❌ [pre-push error] Backend API contracts were modified but client types are out of sync!"
    echo "   The contract at apps/client/src/api/generated/api-schema.ts was regenerated with changes."
    echo "   Please stage and commit the updated api-schema.ts before pushing."
    echo ""
    exit 1
  fi
  echo "✅ Client API schema is in sync with backend."
fi

