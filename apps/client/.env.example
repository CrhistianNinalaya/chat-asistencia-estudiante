# ===================================================================
# Client Environment Configuration
# ===================================================================

# REST API Base URL (Spring Boot Backend)
# Local development:  http://localhost:8080/api
# Production example: https://chat-demo.duckdns.org/api
VITE_API_URL=http://localhost:8080/api

# WebSocket STOMP Handshake URL
# Local development:  ws://localhost:8080/chat-websocket
# Production example: wss://chat-demo.duckdns.org/chat-websocket
VITE_WS_URL=ws://localhost:8080/chat-websocket
